# Monthly price shown in the UI. Clamped to 29.99–39.99.
NEXT_PUBLIC_PRICE_MONTHLY=34.99

# Supabase (Project Settings → API). See README → "Accounts & cloud".
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret, used for "Delete account". Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
